rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No sign-in: anyone with the app link can read and edit.
    // Writes must look like a real game / tab name, and stay small.
    match /games/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().size() <= 12
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.team is string && request.resource.data.team.size() <= 80;
    }
    match /weekTabs/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.tab is string && request.resource.data.tab.size() <= 60;
    }
    match /meta/{id} { allow read, write: if true; }
  }
}
