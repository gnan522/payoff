rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the app link can see games; only signed-in coaches can change them.
    match /games/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /weekTabs/{id} { allow read: if true; allow write: if request.auth != null; }
    match /meta/{id}     { allow read: if true; allow write: if request.auth != null; }
  }
}
